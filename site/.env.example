# arboleda.co — server environment variables
# Set these in Cloudflare → Pages → your project → Settings → Environment variables.
# NONE of these belong in the browser or in config.js. Service-role + Stripe secrets
# are server-only.

# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # "service_role" secret — server only, full access

# Stripe (Developers → API keys; Webhooks → signing secret)
STRIPE_SECRET_KEY=sk_live_...           # use sk_test_... while testing
STRIPE_WEBHOOK_SECRET=whsec_...         # from the webhook endpoint you create

# Your canonical site URL (used for Stripe success/cancel redirects)
SITE_URL=https://arboleda.co

# ── Browser config (this goes in site/config.js, NOT here) ──
# window.ARBOLEDA_CONFIG = {
#   supabaseUrl: 'https://YOUR-PROJECT.supabase.co',
#   supabaseAnonKey: 'eyJ...'   // the "anon"/public key — safe in the browser
# };
